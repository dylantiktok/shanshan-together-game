{
  "name": "aokemeng-workbench",
  "productName": "AOKEMENG TikTok Operations Workbench",
  "version": "0.1.0",
  "description": "AOKEMENG TikTok 智能运营工作台 - 本地电商运营工作台 (Windows/macOS 桌面版)",
  "main": "electron/main.js",
  "private": true,
  "author": "AOKEMENG Malaysia Sdn Bhd",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "shortcut": "node scripts/create-shortcut.js",
    "setup:electron": "node scripts/install-electron.js",
    "server": "node server/cli.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never"
  },
  "build": {
    "appId": "my.aokemeng.workbench",
    "productName": "AOKEMENG Workbench",
    "copyright": "Copyright © AOKEMENG Malaysia Sdn Bhd",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "server/**",
      "web/**",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "templates",
        "to": "templates"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "AOKEMENG 运营工作台",
      "uninstallDisplayName": "AOKEMENG 运营工作台",
      "artifactName": "AOKEMENG-Workbench-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business",
      "icon": "build/icon.png"
    },
    "publish": null
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "express": "^5.3.0",
    "sql.js": "^1.15.2"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  }
}
